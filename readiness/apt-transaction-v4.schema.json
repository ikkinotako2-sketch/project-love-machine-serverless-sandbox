{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "plm-apt-transaction-v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inventory_sha256",
    "index_cohort_sha256",
    "root_constraints",
    "packages",
    "dependency_selections",
    "counts"
  ],
  "properties": {
    "schema": {
      "const": "plm-apt-transaction-v4"
    },
    "inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "index_cohort_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root_constraints": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9][A-Za-z0-9.+:~_-]*$"
      }
    },
    "packages": {
      "type": "array",
      "minItems": 10,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "architecture",
          "action",
          "previous_version",
          "repository",
          "suite",
          "pocket",
          "component",
          "filename",
          "sha256"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9][A-Za-z0-9.+:~_-]*$"
          },
          "architecture": {
            "enum": [
              "amd64",
              "all"
            ]
          },
          "action": {
            "enum": [
              "Install",
              "Upgrade",
              "Downgrade",
              "Remove",
              "Keep"
            ]
          },
          "previous_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "repository": {
            "const": "https://archive.ubuntu.com/ubuntu"
          },
          "suite": {
            "const": "noble"
          },
          "pocket": {
            "const": "release"
          },
          "component": {
            "enum": [
              "main",
              "universe"
            ]
          },
          "filename": {
            "type": "string",
            "pattern": "^pool/(main|universe)/[^\\s]+\\.deb$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "dependency_selections": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "field",
          "alternatives",
          "selected_provider",
          "selected_version",
          "virtual"
        ],
        "properties": {
          "package": {
            "type": "string"
          },
          "field": {
            "enum": [
              "Depends",
              "Pre-Depends"
            ]
          },
          "alternatives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "prefixItems": [
                {
                  "type": "string"
                },
                {
                  "enum": [
                    "=",
                    ">=",
                    "<=",
                    "<<",
                    ">>",
                    null
                  ]
                },
                {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              ],
              "items": false
            }
          },
          "selected_provider": {
            "type": "string"
          },
          "selected_version": {
            "type": "string"
          },
          "virtual": {
            "type": "boolean"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install_count",
        "upgrade_count",
        "remove_count",
        "downgrade_count",
        "keep_count"
      ],
      "properties": {
        "install_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "upgrade_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "remove_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "downgrade_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "keep_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    }
  }
}
