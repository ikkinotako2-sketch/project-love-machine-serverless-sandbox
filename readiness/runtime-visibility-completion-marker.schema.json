  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "state",
    "prepared_commit_sha",
    "workflow_sha256",
    "helper_sha256",
    "plan_sha256",
    "schema_sha256",
    "census_sha256",
    "prior_evidence_sha256",
    "parser_dependency_sha256",
    "target_manifest_sha256",
    "known_source_sha256"
  ],
  "properties": {
    "identity": {
      "const": "provider-neutral-runtime-visibility-completion-20261011-r1"
    },
    "state": {
