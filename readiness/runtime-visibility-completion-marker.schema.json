    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "helper_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "census_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prior_evidence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "parser_dependency_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "known_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
