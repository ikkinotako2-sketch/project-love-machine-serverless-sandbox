{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "state",
    "prepared_commit_sha",
    "workflow_sha256",
    "helper_sha256",
    "plan_sha256"
  ],
  "properties": {
    "identity": {
      "const": "provider-neutral-0008-backend-token-verify-20261010-r1"
    },
    "state": {
      "const": "CONSUMED_BEFORE_REMOTE"
    },
    "prepared_commit_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "workflow_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "helper_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
